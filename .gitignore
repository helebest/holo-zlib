.tmp/

# Build artifacts
*.skill
/dist/
build/

# Credentials, private notes, and downloads. NOT anchored to the repo root: the skill's
# runtime fallback writes them under skills/holo-zlib/{credentials,ebooks}/ too, so these
# must match at any depth.
credentials/
private/
ebooks/
# Backstop: never commit credential files, by either naming scheme.
*credentials*.json
zlib.json

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Test/eval workspace artifacts
holo-zlib-workspace/
